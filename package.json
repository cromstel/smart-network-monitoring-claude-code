{
  "name": "smart-network-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted home network monitor: device discovery, bandwidth history, alerts.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts latest",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:seed": "tsx scripts/seed.ts",
    "bench": "cross-env LOG_LEVEL=silent tsx scripts/bench.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mysql": "cross-env DB_CLIENT=mysql jest --testPathPattern=integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "kysely": "^0.28.8",
    "lucide-react": "^0.544.0",
    "mysql2": "^3.15.0",
    "next": "^15.5.26",
    "node-cron": "^4.2.1",
    "oui-data": "^2.1.28",
    "pino": "^9.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "recharts": "^3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.26",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
