# Database — 'sqlite' (development) or 'mysql' (production)
DB_CLIENT=sqlite
DB_FILE=./data/dev.db

# MySQL — required when DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_name
DB_USER=db_username
DB_PASSWORD=db_password

# Security — generate with: openssl rand -hex 32   (or run: npm run setup)
SESSION_SECRET=
ENCRYPTION_KEY=          # 32 bytes hex (64 chars), AES-256-GCM for router credentials

# Network
NETWORK_SUBNET=192.168.1.0/24
SCANNER_MODE=simulated   # simulated | arp | asus
SCAN_INTERVAL_SECONDS=30

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Run pending migrations when the server starts (recommended)
AUTO_MIGRATE=true
# Set to false to disable the background scanner/cron jobs (e.g. in a second replica)
SCHEDULER_ENABLED=true
# Session cookie 'Secure' flag. Defaults to true when NODE_ENV=production.
# Set to false ONLY if you access the dashboard over plain HTTP on a trusted LAN.
# COOKIE_SECURE=true
